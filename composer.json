{
    "name": "ceramicentro/ceramishop",
    "description": "CERAMISHOP - Tienda en línea de CERAMICENTRO (PHP + MongoDB)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "mongodb/mongodb": "^1.16 || ^2.0",
        "phpoffice/phpspreadsheet": "^5.2",
        "tecnickcom/tcpdf": "^6.7",
        "phpmailer/phpmailer": "^6.9",
        "ext-mongodb": "*"
    },
    "suggest": {
        "ext-gd": "Necesaria para optimizar/convertir imágenes a WebP al subirlas",
        "ext-zip": "Necesaria para exportar a Excel (PhpSpreadsheet)"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.12",
            "ext-mongodb": "1.16.2"
        }
    }
}
