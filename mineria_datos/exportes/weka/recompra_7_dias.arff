% Clase: ¿el cliente vuelve a comprar en los próximos 7 días?
% Sugerido: J48, NaiveBayes, Logistic; revisar área ROC y matriz de confusión.
@RELATION recompra_7_dias

@ATTRIBUTE n_pedidos NUMERIC
@ATTRIBUTE gasto_total NUMERIC
@ATTRIBUTE ticket_promedio NUMERIC
@ATTRIBUTE ticket_ultimo NUMERIC
@ATTRIBUTE items_ultimo NUMERIC
@ATTRIBUTE intervalo_promedio NUMERIC
@ATTRIBUTE dias_desde_anterior NUMERIC
@ATTRIBUTE tasa_cancelacion NUMERIC
@ATTRIBUTE tasa_envio_gratis NUMERIC
@ATTRIBUTE variedad_categorias NUMERIC
@ATTRIBUTE dia_semana NUMERIC
@ATTRIBUTE hora NUMERIC
@ATTRIBUTE pct_Accesorios NUMERIC
@ATTRIBUTE pct_Camisetas NUMERIC
@ATTRIBUTE pct_Chaquetas NUMERIC
@ATTRIBUTE pct_Conjuntos NUMERIC
@ATTRIBUTE pct_Pantalones NUMERIC
@ATTRIBUTE pct_Sudaderas NUMERIC
@ATTRIBUTE ultima_categoria {'Accesorios','Camisetas','Chaquetas','Conjuntos','Pantalones','Sudaderas'}
@ATTRIBUTE ciudad {'Barranquilla','Bogotá','Bucaramanga','Cali','Manizales','Medellín','Mosquera','Pereira','Soacha','Tunja'}
@ATTRIBUTE recompra {'si','no'}

